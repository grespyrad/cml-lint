ValueRegister ServiceValues {
  ValueCluster Reliability {
    core = "Reliability"
    demonstrator = "Accepted requests"
    relatedValue = "Availability"
    opposingValue = "Complexity"

    Value Availability {
      isCore
      demonstrator = "Available service"

      Stakeholder Client {
        priority = HIGH
        impact = HIGH
        consequences
        good "Requests are accepted" action "Monitor results" MONITOR
        bad "Service can fail"
      }
    }
  }
}
